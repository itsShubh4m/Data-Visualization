      <aliases enabled='yes' />
      <column caption='Semester' datatype='string' name='[Calculation_1228191806234624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;Sem1&quot;) THEN &quot;Semester 1&quot; &#13;&#10;ELSEIF CONTAINS([Table Name], &quot;Sem2&quot;) THEN &quot;Semester 2&quot; &#13;&#10;ELSE &quot;Other&quot; &#13;&#10;END' />
      </column>
      <column caption='Total_Score' datatype='real' name='[Calculation_1228191814451201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Math] + [Physics] + [Chemistry] + [Programming]' />
      </column>
      <column caption='Overall_Percentage' datatype='real' default-format='p0.0%' name='[Calculation_1228191814856706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1228191814451201] / 400.0' />
      </column>
      <column caption='Performance_Band' datatype='string' name='[Calculation_1228191815917571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1228191814856706] &gt;= 0.85 THEN &quot;Distinction&quot; &#13;&#10;ELSEIF [Calculation_1228191814856706] &gt;= 0.75 THEN &quot;First Class&quot; &#13;&#10;ELSEIF [Calculation_1228191814856706] &gt;= 0.60 THEN &quot;Second Class&quot;&#13;&#10;ELSE &quot;Needs Academic Support&quot; &#13;&#10;END' />
      </column>
      <column caption='Attendance_Status ' datatype='string' name='[Calculation_1228191816097796]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF FLOAT(REPLACE([Attendance], &quot;%&quot;, &quot;&quot;)) &gt;= 75 THEN&#13;&#10;    &quot;Eligible (Good Standing)&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Shortage Warning (&lt;75%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Dept_Average_Percentage_LOD' datatype='real' default-format='p0.0%' name='[Calculation_1228191821639685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Dept_Info] : AVG([Calculation_1228191814856706]) }' />
      </column>
      <column caption='Student_Overall_Career_Average' datatype='real' name='[Calculation_1228191822262278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Student_ID] : AVG([Calculation_1228191814856706]) }' />
      </column>
      <column caption='Variance_From_Dept_Average' datatype='real' default-format='p0.0%' name='[Calculation_1228191822508039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1228191814856706] - [Calculation_1228191821639685]' />
      </column>
      <column caption='Benchmark_Status' datatype='string' name='[Calculation_1228191823183880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1228191822508039] &gt;= 0 THEN &quot;Above Department &#13;&#10;Benchmark&quot; &#13;&#10;ELSE &quot;Below Department Benchmark&quot; &#13;&#10;END' />
      </column>
      <column caption='ull_Name_Clean' datatype='string' name='[Calculation_1228191826268170]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT(TRIM([Full_Name]), 1)) +  &#13;&#10;LOWER(MID(TRIM([Full_Name]), 2, FIND(TRIM([Full_Name]), &quot; &quot;) - &#13;&#10;1)) +  &#13;&#10;&quot; &quot; +  &#13;&#10;UPPER(MID(TRIM([Full_Name]), FIND(TRIM([Full_Name]), &quot; &quot;) + 1, &#13;&#10;1)) +  &#13;&#10;LOWER(MID(TRIM([Full_Name]), FIND(TRIM([Full_Name]), &quot; &quot;) + 2, &#13;&#10;LEN(TRIM([Full_Name]))))' />
      </column>
      <column caption='First_Name' datatype='string' name='[Calculation_1228191826710539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(SPLIT([Full_Name], &quot; &quot;, 1))' />
      </column>
      <column caption='Last_Name' datatype='string' name='[Calculation_1228191827533836]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(SPLIT([Full_Name], &quot; &quot;, -1))' />
      </column>
      <column caption='Dept_Branch' datatype='string' name='[Calculation_1228191828119565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Dept_Info], &quot;-&quot;, 1)' />
      </column>
      <column caption='Section_ID ' datatype='string' name='[Calculation_1228191828336654]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Dept_Info], &quot;-&quot;, 2)' />
      </column>
      <column caption='student_Display_Label' datatype='string' name='[Calculation_1228191828828175]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Student_ID] + &quot; - &quot; + [Calculation_1228191826268170] + &quot; (&quot; + [Calculation_1228191828119565] + &quot;)&quot;' />
      </column>
      <column caption='Club Membership' datatype='string' name='[Club_Membership]' role='dimension' type='nominal' />
      <column caption='Department Name' datatype='string' name='[Department_Name]' role='dimension' type='nominal' />
