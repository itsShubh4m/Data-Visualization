      <aliases enabled='yes' />
      <column caption='Cumulative Votes (RUNNING_SUM)' datatype='integer' name='[Calculation_0962103621730306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Restaurant Rank' datatype='integer' name='[Calculation_0962103626416131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([votes]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City Window Avg Cost' datatype='real' name='[Calculation_0962103630155780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([approx_cost(for two people)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference from Window Sum' datatype='real' name='[Calculation_0962103636312069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([votes]) - WINDOW_AVG(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic Title' datatype='string' name='[Calculation_0962103644798987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Top &quot; + STR([Parameters].[Parameter 0962103643475976]) + &quot; Restaurants by Total &#13;&#10;Votes&quot;' />
      </column>
