      <aliases enabled='yes' />
      <column caption='Average Order Value' datatype='integer' name='[Average_Order_Value]' role='measure' type='quantitative' />
      <column caption='Brand Awareness' datatype='real' name='[Brand_Awareness]' role='measure' type='quantitative' />
      <column caption='Brand Loyalty' datatype='real' name='[Brand_Loyalty]' role='measure' type='quantitative' />
      <column caption='Brand Name' datatype='string' name='[Brand_Name]' role='dimension' type='nominal' />
      <column caption='Profit Margin Ratio' datatype='real' name='[Calculation_0494810836127746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Revenue] - [Cost_Price]) / [Revenue]' />
      </column>
      <column caption='Total Revenue Before Discount' datatype='integer' name='[Calculation_0494810840416260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Units_Sold] * [Unit_Price]' />
      </column>
      <column caption=' Aggregate Profit Margin' datatype='real' name='[Calculation_0494810846199813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([Unit_Price] - [Cost_Price]) * [Units_Sold])&#13;&#10;/&#13;&#10;SUM([Unit_Price] * [Units_Sold])' />
      </column>
      <column caption='Fixed Regional Sales' datatype='integer' name='[Calculation_0494810848268294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [City] : SUM([Revenue]) }' />
      </column>
      <column caption='Include Sales per store' datatype='integer' name='[Calculation_0494810851688455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Store_ID] : SUM([Revenue]) }' />
      </column>
      <column aggregation='Attribute' caption='Exclude Category Sales' datatype='integer' name='[Calculation_0494810856685576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Sub_Category] : SUM([Revenue]) }' />
      </column>
      <column caption='KPI Threshold Met?' datatype='string' name='[Calculation_0494810859683850]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit_Margin]) &gt;= [Parameters].[Parameter 0494810858233865] THEN &quot;Target Achieved&quot; &#13;&#10;ELSE &quot;Below Target&quot; &#13;&#10;END' />
      </column>
      <column caption='cleaned Discount' datatype='integer' name='[Calculation_0494810868592651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Max_Discount_Offered], 0)' />
      </column>
      <column caption='Standardized City Tier' datatype='string' name='[Calculation_0494810869719052]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([City_Tier])' />
      </column>
